---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "DownloadSoftware — Open Source Alternatives to Proprietary Software",
  description = "Discover verified open source alternatives to popular commercial SaaS tools like Notion, Slack, Airtable, and more. Self-hostable, privacy-friendly software.",
  canonical = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Open Graph / SEO -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Inter Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#F8FAFC] text-[#0F172A] font-sans antialiased min-h-screen flex flex-col selection:bg-blue-500 selection:text-white">
    <!-- Top Announcement Bar -->
    <div class="bg-[#0F172A] text-slate-300 text-xs py-2 px-4 text-center border-b border-slate-800">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Curated Directory: 100% Free & Open Source Alternatives for Developers & Teams</span>
      </span>
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg shadow-sm group-hover:scale-105 transition-transform">
            ⚡
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-lg tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors">
              DownloadSoftware<span class="text-blue-600">.eu</span>
            </span>
            <span class="text-[10px] text-slate-500 font-medium -mt-1 tracking-wider uppercase">Open Source Directory</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-blue-600 transition-colors">All Alternatives</a>
          <a href="/alternatives-to" class="hover:text-blue-600 transition-colors">SaaS Brands</a>
          <a href="https://github.com/Yusufkotavom/downloadsoftware-platform" target="_blank" rel="noreferrer" class="flex items-center gap-1.5 text-slate-700 hover:text-black">
            <span>GitHub</span>
            <span class="text-xs px-1.5 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-600">v1.0</span>
          </a>
        </nav>

        <div class="flex items-center gap-3">
          <a href="/alternatives-to" class="text-xs font-semibold px-3.5 py-2 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition-colors border border-blue-200">
            Browse Directory →
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="md:col-span-2">
            <span class="font-extrabold text-lg text-slate-900">
              DownloadSoftware<span class="text-blue-600">.eu.org</span>
            </span>
            <p class="mt-2 text-sm text-slate-500 max-w-sm">
              Discover and self-host the best open-source alternatives to expensive proprietary SaaS platforms. Take back control of your privacy and cloud data.
            </p>
          </div>
          <div>
            <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Popular Alternatives</h4>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              <li><a href="/alternativesto/notion" class="hover:text-blue-600">Alternative to Notion</a></li>
              <li><a href="/alternativesto/slack" class="hover:text-blue-600">Alternative to Slack</a></li>
              <li><a href="/alternativesto/airtable" class="hover:text-blue-600">Alternative to Airtable</a></li>
              <li><a href="/alternativesto/trello" class="hover:text-blue-600">Alternative to Trello</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Navigation</h4>
            <ul class="mt-3 space-y-2 text-sm text-slate-600">
              <li><a href="/" class="hover:text-blue-600">All Software</a></li>
              <li><a href="/alternatives-to" class="hover:text-blue-600">Proprietary Index</a></li>
              <li><a href="/sitemap-index.xml" class="hover:text-blue-600">Sitemap XML</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
          <p>© 2026 DownloadSoftware. Independent open-source software directory.</p>
          <p>Built with Astro + Tailwind CSS</p>
        </div>
      </div>
    </footer>
  </body>
</html>
