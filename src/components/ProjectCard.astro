---
export interface Props {
  project: {
    id: string;
    name: string;
    tagline: string;
    category: string;
    alternative_to: string[];
    github_repo: string;
    stars: number;
    forks: number;
    license: string;
    languages: string[];
    website: string;
    logo: string;
    description: string;
  };
}

const { project } = Astro.props;
---

<div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:border-blue-400 hover:shadow-lg transition-all duration-200 group">
  <div>
    <!-- Card Top Header -->
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <img
          src={project.logo}
          alt={project.name}
          width="44"
          height="44"
          class="w-11 h-11 rounded-xl object-contain bg-slate-50 border border-slate-100 p-1 group-hover:scale-105 transition-transform"
          loading="lazy"
          onerror="this.src='/favicon.svg'"
        />
        <div>
          <a href={`/project/${project.id}`} class="font-bold text-slate-900 text-lg hover:text-blue-600 transition-colors">
            {project.name}
          </a>
          <span class="block text-xs font-medium text-slate-500">
            {project.category}
          </span>
        </div>
      </div>

      <!-- GitHub Stars Badge -->
      <a
        href={`https://github.com/${project.github_repo}`}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-xs font-semibold hover:bg-amber-100 transition-colors"
      >
        <span>★</span>
        <span>{project.stars.toLocaleString()}</span>
      </a>
    </div>

    <!-- Description -->
    <p class="mt-4 text-sm text-slate-600 line-clamp-2 leading-relaxed">
      {project.tagline}
    </p>

    <!-- Alternatives Pill -->
    <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center gap-1.5 text-xs">
      <span class="text-slate-400 font-medium">Alternative to:</span>
      {project.alternative_to.map((alt) => (
        <a
          href={`/alternativesto/${alt}`}
          class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 font-semibold hover:bg-blue-100 capitalize border border-blue-100 transition-colors"
        >
          {alt}
        </a>
      ))}
    </div>
  </div>

  <!-- Footer Actions -->
  <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-slate-100 text-slate-600">
        {project.license}
      </span>
      <span class="text-xs text-slate-400">
        {project.languages.slice(0, 2).join(", ")}
      </span>
    </div>

    <a
      href={`/project/${project.id}`}
      class="text-xs font-semibold text-blue-600 group-hover:translate-x-0.5 transition-transform flex items-center gap-1"
    >
      Details <span>→</span>
    </a>
  </div>
</div>
