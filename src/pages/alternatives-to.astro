---
import Layout from '../layouts/Layout.astro';
import proprietaryData from '../data/proprietary.json';
import projectsData from '../data/projects.json';
---

<Layout
  title="All Commercial SaaS Tools & Their Open Source Alternatives"
  description="Browse the complete index of proprietary software (Notion, Slack, Trello, Airtable) and find their verified self-hostable open source alternatives."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-3xl mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Proprietary SaaS Directory
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Select a commercial cloud tool below to view all open source, community-tested alternatives that can be self-hosted on your own servers.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {proprietaryData.map((item) => {
        const alts = projectsData.filter((p) => p.alternative_to.includes(item.id));
        return (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 flex flex-col justify-between hover:border-blue-400 hover:shadow-md transition-all group">
            <div>
              <div class="flex items-center gap-4">
                <img
                  src={item.logo}
                  alt={item.name}
                  class="w-12 h-12 rounded-xl object-contain bg-slate-50 border border-slate-100 p-1 group-hover:scale-105 transition-transform"
                />
                <div>
                  <h2 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                    <a href={`/alternativesto/${item.id}`}>{item.name}</a>
                  </h2>
                  <span class="text-xs text-blue-600 font-semibold">{alts.length} alternatives available</span>
                </div>
              </div>

              <p class="mt-4 text-sm text-slate-600 line-clamp-2 leading-relaxed">
                {item.tagline}
              </p>

              <!-- Alternatives quick list -->
              <div class="mt-4 pt-4 border-t border-slate-100">
                <span class="text-xs font-semibold text-slate-400 block mb-2">Verified Alternatives:</span>
                <div class="flex flex-wrap gap-1.5">
                  {alts.map(a => (
                    <a
                      href={`/project/${a.id}`}
                      class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium transition-colors"
                    >
                      {a.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100">
              <a
                href={`/alternativesto/${item.id}`}
                class="w-full py-2 px-4 rounded-xl bg-blue-50 text-blue-700 font-bold text-xs hover:bg-blue-100 transition-colors flex items-center justify-center gap-1.5"
              >
                <span>View Full Comparison</span>
                <span>→</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
