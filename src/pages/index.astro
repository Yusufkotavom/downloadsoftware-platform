---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import proprietary from '../data/proprietary.json';

const totalAlternatives = projects.length;
const totalSaaS = proprietary.length;

// Extract categories
const categories = Array.from(new Set(projects.map(p => p.category)));
---

<Layout
  title="DownloadSoftware — Open Source Alternatives to Commercial SaaS"
  description="Discover self-hosted, privacy-first open source alternatives to popular commercial software like Notion, Airtable, Slack, and Trello."
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-16 md:pt-20 md:pb-24 border-b border-slate-200 bg-gradient-to-b from-white to-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold mb-6">
        <span>✨ 100% Free & Community Verified</span>
      </div>

      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight max-w-4xl mx-auto leading-tight">
        Open Source Alternatives to <span class="text-blue-600">Proprietary Software</span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Replace expensive cloud subscriptions with self-hostable, privacy-friendly open source solutions. Own your data without vendor lock-in.
      </p>

      <!-- Stats Bar -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 sm:gap-12 text-sm text-slate-500 font-medium">
        <div class="flex items-center gap-2">
          <span class="text-2xl font-extrabold text-slate-900">{totalAlternatives}</span>
          <span>Open Source Projects</span>
        </div>
        <div class="w-1.5 h-1.5 rounded-full bg-slate-300 hidden sm:block"></div>
        <div class="flex items-center gap-2">
          <span class="text-2xl font-extrabold text-slate-900">{totalSaaS}</span>
          <span>Commercial SaaS Replaced</span>
        </div>
        <div class="w-1.5 h-1.5 rounded-full bg-slate-300 hidden sm:block"></div>
        <div class="flex items-center gap-2">
          <span class="text-2xl font-extrabold text-slate-900">450k+</span>
          <span>Combined GitHub Stars</span>
        </div>
      </div>

      <!-- Quick Brand Jump Pills -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
        <span class="text-xs font-semibold text-slate-400 mr-2">Jump to:</span>
        {proprietary.map(p => (
          <a
            href={`/alternativesto/${p.id}`}
            class="px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-blue-400 hover:text-blue-600 text-xs font-medium transition-all shadow-sm flex items-center gap-1.5"
          >
            <img src={p.logo} alt={p.name} class="w-3.5 h-3.5 object-contain" />
            <span>{p.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Main Directory Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Filter Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl font-extrabold text-slate-900">
          Featured Open Source Projects
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          Showing {projects.length} verified alternatives sorted by community stars
        </p>
      </div>

      <!-- Search Box (Client-side interactive filter) -->
      <div class="relative w-full md:w-80">
        <input
          type="text"
          id="project-search"
          placeholder="Filter by name, SaaS, or tag..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shadow-sm"
        />
        <svg
          class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <!-- Cards Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class="project-item" data-search={`${project.name} ${project.tagline} ${project.category} ${project.alternative_to.join(" ")}`.toLowerCase()}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <!-- Empty State for Search -->
    <div id="empty-state" class="hidden text-center py-16">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-slate-800">No open source software found</h3>
      <p class="text-sm text-slate-500 mt-1">Try another keyword like Notion, Slack, or Trello.</p>
    </div>
  </section>

  <!-- Popular Alternatives Section -->
  <section class="bg-white border-t border-slate-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Discover Open Source Alternatives to:
        </h2>
        <p class="mt-2 text-slate-500 text-sm">
          Browse comprehensive comparisons with full feature breakdowns and migration guides.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {proprietary.map((p) => {
          const matchCount = projects.filter(proj => proj.alternative_to.includes(p.id)).length;
          return (
            <a
              href={`/alternativesto/${p.id}`}
              class="p-5 rounded-2xl border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all group bg-[#F8FAFC]/50 hover:bg-white"
            >
              <div class="flex items-center gap-3">
                <img src={p.logo} alt={p.name} class="w-10 h-10 rounded-xl object-contain bg-white border border-slate-100 p-1 group-hover:scale-105 transition-transform" />
                <div>
                  <h3 class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                    {p.name}
                  </h3>
                  <span class="text-xs text-blue-600 font-semibold">
                    {matchCount} alternatives →
                  </span>
                </div>
              </div>
              <p class="mt-3 text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {p.tagline}
              </p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Client-side filter script -->
  <script is:inline>
    const searchInput = document.getElementById('project-search');
    const items = document.querySelectorAll('.project-item');
    const emptyState = document.getElementById('empty-state');

    searchInput?.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      let matchCount = 0;

      items.forEach((item) => {
        const searchData = item.getAttribute('data-search') || '';
        if (query === '' || searchData.includes(query)) {
          item.classList.remove('hidden');
          matchCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (matchCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    });
  </script>
</Layout>
